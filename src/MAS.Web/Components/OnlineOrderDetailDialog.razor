@inject IOnlineOrderService OrderService
@inject UserSession Session

<MudDialog>
    <DialogContent>
        @if (order == null) { <MudProgressLinear Indeterminate="true" /> }
        else
        {
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2">العميل: <strong>@order.CustomerName</strong></MudText>
                    <MudText Typo="Typo.subtitle2">الهاتف: <strong>@order.CustomerPhone</strong></MudText>
                    @if (!string.IsNullOrEmpty(order.CustomerEmail))
                    {
                        <MudText Typo="Typo.subtitle2">البريد: <strong>@order.CustomerEmail</strong></MudText>
                    }
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2">المدينة: <strong>@order.City</strong></MudText>
                    <MudText Typo="Typo.subtitle2">الدفع: <strong>@(order.PaymentMethod == "COD" ? "عند الاستلام" : order.PaymentMethod)</strong></MudText>
                    <MudText Typo="Typo.subtitle2">التاريخ: <strong>@order.OrderDate.ToString("yyyy/MM/dd HH:mm")</strong></MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Class="pa-2" Style="background: #f9fafb;">
                        <MudText Typo="Typo.caption">العنوان:</MudText>
                        <MudText>@order.ShippingAddress</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mt-2">الأصناف:</MudText>
                    <MudTable Items="@order.Items" Dense="true">
                        <HeaderContent>
                            <MudTh>المنتج</MudTh>
                            <MudTh>الكمية</MudTh>
                            <MudTh>السعر</MudTh>
                            <MudTh>الإجمالي</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ProductName</MudTd>
                            <MudTd>@context.Quantity</MudTd>
                            <MudTd>@context.UnitPrice.ToString("N2")</MudTd>
                            <MudTd>@context.LineTotal.ToString("N2")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Class="pa-3" Style="background: #f0fdfa;">
                        <MudGrid>
                            <MudItem xs="6">إجمالي الأصناف:</MudItem>
                            <MudItem xs="6"><MudText Align="Align.End">@order.SubTotal.ToString("N2") ج</MudText></MudItem>
                            <MudItem xs="6">تكلفة الشحن (الكلية):</MudItem>
                            <MudItem xs="6"><MudText Align="Align.End">@order.ShippingCost.ToString("N2") ج</MudText></MudItem>
                            <MudItem xs="6">على البائع:</MudItem>
                            <MudItem xs="6"><MudText Align="Align.End" Color="Color.Error">-@order.SellerShippingShare.ToString("N2") ج</MudText></MudItem>
                            <MudItem xs="6">على العميل:</MudItem>
                            <MudItem xs="6"><MudText Align="Align.End">@order.CustomerShippingShare.ToString("N2") ج</MudText></MudItem>
                            <MudItem xs="12"><MudDivider /></MudItem>
                            <MudItem xs="6"><MudText Typo="Typo.h6">الإجمالي للعميل:</MudText></MudItem>
                            <MudItem xs="6"><MudText Typo="Typo.h6" Align="Align.End" Color="Color.Primary">@order.GrandTotal.ToString("N2") ج</MudText></MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
                @if (!string.IsNullOrEmpty(order.Notes))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info">ملاحظات: @order.Notes</MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int OrderId { get; set; }
    private OnlineOrderDto? order;

    protected override async Task OnInitializedAsync()
    {
        order = await OrderService.GetOrderByIdAsync(OrderId, Session.BrandId);
    }
}
