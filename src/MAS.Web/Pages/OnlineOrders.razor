@page "/online-orders"
@inject IOnlineOrderService OrderService
@inject UserSession Session
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>الطلبات الأونلاين - MAS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">🌐 الطلبات الأونلاين</MudText>

@if (orders == null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudGrid Class="mb-3">
        <MudItem xs="6" md="2">
            <MudPaper Class="pa-2 text-center" Style="background: #fef3c7;">
                <MudText Typo="Typo.caption">جديد</MudText>
                <MudText Typo="Typo.h6">@orders.Count(o => o.Status == "Pending")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudPaper Class="pa-2 text-center" Style="background: #dbeafe;">
                <MudText Typo="Typo.caption">مؤكد</MudText>
                <MudText Typo="Typo.h6">@orders.Count(o => o.Status == "Confirmed")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudPaper Class="pa-2 text-center" Style="background: #e0e7ff;">
                <MudText Typo="Typo.caption">قيد التجهيز</MudText>
                <MudText Typo="Typo.h6">@orders.Count(o => o.Status == "Preparing")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudPaper Class="pa-2 text-center" Style="background: #fde68a;">
                <MudText Typo="Typo.caption">في الطريق</MudText>
                <MudText Typo="Typo.h6">@orders.Count(o => o.Status == "OutForDelivery")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudPaper Class="pa-2 text-center" Style="background: #ecfdf5;">
                <MudText Typo="Typo.caption">تم التسليم</MudText>
                <MudText Typo="Typo.h6">@orders.Count(o => o.Status == "Delivered")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudPaper Class="pa-2 text-center" Style="background: #fee2e2;">
                <MudText Typo="Typo.caption">ملغي</MudText>
                <MudText Typo="Typo.h6">@orders.Count(o => o.Status == "Cancelled")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (!orders.Any()) { <MudAlert Severity="Severity.Info">لا يوجد طلبات أونلاين بعد.</MudAlert> }
    else
    {
        <MudPaper Class="pa-3">
            <MudTable Items="@orders" Hover="true" Bordered="true">
                <HeaderContent>
                    <MudTh>رقم الطلب</MudTh>
                    <MudTh>التاريخ</MudTh>
                    <MudTh>العميل</MudTh>
                    <MudTh>الهاتف</MudTh>
                    <MudTh>المدينة</MudTh>
                    <MudTh>الإجمالي</MudTh>
                    <MudTh>الحالة</MudTh>
                    <MudTh>الإجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.OrderNumber</MudTd>
                    <MudTd>@context.OrderDate.ToString("yyyy/MM/dd HH:mm")</MudTd>
                    <MudTd>@context.CustomerName</MudTd>
                    <MudTd>@context.CustomerPhone</MudTd>
                    <MudTd>@context.City</MudTd>
                    <MudTd><strong>@context.GrandTotal.ToString("N2")</strong></MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Status)">@TranslateStatus(context.Status)</MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => ViewOrder(context))" />
                        @if (context.Status == "Pending" || context.Status == "Confirmed" || context.Status == "Preparing" || context.Status == "OutForDelivery")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Success"
                                           Title="نقل للحالة التالية" OnClick="@(() => MoveStatus(context))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    private List<OnlineOrderDto>? orders;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        if (Session.IsAuthenticated)
            orders = await OrderService.GetOrdersAsync(Session.BrandId);
    }

    private async Task ViewOrder(OnlineOrderDto order)
    {
        var parameters = new DialogParameters { ["OrderId"] = order.OrderId };
        await DialogService.ShowAsync<OnlineOrderDetailDialog>($"تفاصيل الطلب {order.OrderNumber}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await LoadData();
    }

    private async Task MoveStatus(OnlineOrderDto order)
    {
        var nextStatus = order.Status switch
        {
            "Pending" => "Confirmed",
            "Confirmed" => "Preparing",
            "Preparing" => "OutForDelivery",
            "OutForDelivery" => "Delivered",
            _ => order.Status
        };

        if (nextStatus == "Delivered")
        {
            // تحويل لفاتورة فعلية
            try
            {
                await OrderService.ConvertToInvoiceAsync(order.OrderId, Session.BrandId, Session.CurrentBranchId, Session.UserId);
                Snackbar.Add($"تم التسليم وإنشاء فاتورة - خصم المخزون تلقائياً", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"خطأ: {ex.Message}", Severity.Error); }
        }
        else
        {
            await OrderService.UpdateOrderStatusAsync(order.OrderId, Session.BrandId, nextStatus, Session.UserId);
            Snackbar.Add($"تم تحديث الحالة إلى: {TranslateStatus(nextStatus)}", Severity.Success);
        }
        await LoadData();
    }

    private string TranslateStatus(string status) => status switch
    {
        "Pending" => "جديد",
        "Confirmed" => "مؤكد",
        "Preparing" => "قيد التجهيز",
        "OutForDelivery" => "في الطريق",
        "Delivered" => "تم التسليم",
        "Cancelled" => "ملغي",
        "Returned" => "مرتجع",
        _ => status
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Pending" => Color.Warning,
        "Confirmed" => Color.Info,
        "Preparing" => Color.Primary,
        "OutForDelivery" => Color.Tertiary,
        "Delivered" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}
