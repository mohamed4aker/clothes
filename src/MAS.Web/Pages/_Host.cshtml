@page "/"
@namespace MAS.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MAS - نظام إدارة الأعمال</title>
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css?family=Cairo:400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    <component type="typeof(App)" render-mode="Server" />

    <div id="blazor-error-ui" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:1100; background:#b91c1c; color:#fff; padding:12px 20px; text-align:center; box-shadow:0 -2px 10px rgba(0,0,0,.3); font-family:'Cairo',sans-serif;">
        حصل خطأ غير متوقع.
        <a href="" class="reload" style="color:#fff; text-decoration:underline; margin:0 8px;">إعادة تحميل</a>
        <a class="dismiss" style="cursor:pointer; color:#fff;">🗙</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script>
        // إعادة الاتصال التلقائي: لو الاتصال بالسيرفر وقع، بنحاول نرجّعه بهدوء،
        // ولو معرفناش خلال ~15 ثانية بنعمل reload تلقائي (الجلسة محفوظة فمش هتخرج من الدخول)
        (function () {
            var reloadTimer = null;
            Blazor.start({
                reconnectionOptions: {
                    maxRetries: 8,
                    retryIntervalMilliseconds: 1500
                },
                reconnectionHandler: {
                    onConnectionDown: function () {
                        if (!reloadTimer) {
                            reloadTimer = setTimeout(function () {
                                location.reload();
                            }, 15000);
                        }
                    },
                    onConnectionUp: function () {
                        if (reloadTimer) {
                            clearTimeout(reloadTimer);
                            reloadTimer = null;
                        }
                    }
                }
            });
        })();
    </script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
