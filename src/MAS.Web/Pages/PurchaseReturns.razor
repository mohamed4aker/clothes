@page "/purchase-returns"
@inject IPurchaseReturnService ReturnService
@inject UserSession Session
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>مرتجع المشتريات - MAS</PageTitle>

<MudGrid>
    <MudItem xs="12" Class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.h4">↩️ مرتجع المشتريات</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAdd">
            إضافة مرتجع جديد
        </MudButton>
    </MudItem>
</MudGrid>

@if (returns != null && returns.Any())
{
    <MudGrid Class="mt-3">
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3 text-center" Style="background: #fef3c7;">
                <MudText Typo="Typo.subtitle2">عدد المرتجعات</MudText>
                <MudText Typo="Typo.h5">@returns.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3 text-center" Style="background: #fee2e2;">
                <MudText Typo="Typo.subtitle2">إجمالي المرتجعات</MudText>
                <MudText Typo="Typo.h5" Color="Color.Error">@returns.Sum(r => r.SubTotal).ToString("N2") ج</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3 text-center" Style="background: #ecfdf5;">
                <MudText Typo="Typo.subtitle2">المسترد نقداً</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success">@returns.Where(r => r.RefundMethod == "Cash").Sum(r => r.RefundAmount).ToString("N2") ج</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3 text-center" Style="background: #dbeafe;">
                <MudText Typo="Typo.subtitle2">على حساب المورد</MudText>
                <MudText Typo="Typo.h5">@returns.Where(r => r.RefundMethod == "Credit").Sum(r => r.RefundAmount).ToString("N2") ج</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<MudPaper Class="pa-4 mt-3">
    @if (returns == null) { <MudProgressLinear Indeterminate="true" /> }
    else if (!returns.Any()) { <MudAlert Severity="Severity.Info">لا يوجد مرتجعات مشتريات.</MudAlert> }
    else
    {
        <MudTable Items="@returns" Hover="true" Bordered="true" Dense="true">
            <HeaderContent>
                <MudTh>رقم المرتجع</MudTh>
                <MudTh>التاريخ</MudTh>
                <MudTh>الفاتورة الأصلية</MudTh>
                <MudTh>المورد</MudTh>
                <MudTh>السبب</MudTh>
                <MudTh>عدد الأصناف</MudTh>
                <MudTh>الإجمالي</MudTh>
                <MudTh>المسترد</MudTh>
                <MudTh>طريقة الاسترداد</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><strong>@context.ReturnNumber</strong></MudTd>
                <MudTd>@context.ReturnDate.ToString("yyyy/MM/dd")</MudTd>
                <MudTd>@(context.PurchaseInvoiceNumber ?? "-")</MudTd>
                <MudTd>@context.SupplierName</MudTd>
                <MudTd>@context.Reason</MudTd>
                <MudTd>@context.ItemsCount</MudTd>
                <MudTd><strong>@context.SubTotal.ToString("N2") ج</strong></MudTd>
                <MudTd><strong style="color: green;">@context.RefundAmount.ToString("N2") ج</strong></MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@GetRefundColor(context.RefundMethod)">
                        @TranslateMethod(context.RefundMethod)
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<PurchaseReturnDto>? returns;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        if (Session.IsAuthenticated)
            returns = await ReturnService.GetReturnsAsync(Session.BrandId);
    }

    private async Task OpenAdd()
    {
        var dialog = DialogService.Show<PurchaseReturnDialog>("مرتجع مشتريات",
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            Snackbar.Add("تم حفظ المرتجع وخصم الكميات من المخزون", Severity.Success);
            await LoadData();
        }
    }

    private string TranslateMethod(string m) => m switch
    {
        "Cash" => "كاش",
        "Visa" => "فيزا",
        "Credit" => "خصم من حساب المورد",
        _ => m
    };

    private Color GetRefundColor(string m) => m switch
    {
        "Cash" => Color.Success,
        "Visa" => Color.Info,
        "Credit" => Color.Warning,
        _ => Color.Default
    };
}
