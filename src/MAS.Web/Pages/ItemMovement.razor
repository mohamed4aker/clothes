@page "/item-movement"
@inject AppDbContext Context
@inject IProductService ProductService
@inject UserSession Session

<PageTitle>حركة الصنف - MAS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">🔄 حركة الصنف</MudText>

<MudGrid Class="mb-3">
    <MudItem xs="12" md="6">
        <MudSelect T="int?" @bind-Value="selectedVariantId" Label="اختار الصنف" Variant="Variant.Outlined">
            <MudSelectItem T="int?" Value="null">- اختار صنف -</MudSelectItem>
            @if (products != null)
            {
                @foreach (var p in products)
                {
                    @foreach (var v in p.Variants)
                    {
                        <MudSelectItem T="int?" Value="v.VariantId">@(v.VariantName ?? p.ProductName) (@v.SKU)</MudSelectItem>
                    }
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadMovements" Disabled="@(!selectedVariantId.HasValue)" FullWidth="true" Style="height:56px;">
            عرض الحركة
        </MudButton>
    </MudItem>
</MudGrid>

@if (movements != null)
{
    <MudPaper Class="pa-3">
        <MudTable Items="@movements" Hover="true" Bordered="true" Dense="true">
            <HeaderContent>
                <MudTh>التاريخ</MudTh>
                <MudTh>النوع</MudTh>
                <MudTh>الكمية</MudTh>
                <MudTh>الرصيد بعد</MudTh>
                <MudTh>التكلفة</MudTh>
                <MudTh>المرجع</MudTh>
                <MudTh>ملاحظات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.CreatedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>
                <MudTd>
                    <MudChip Size="Size.Small" Color="@GetMovementColor(context.MovementType.ToString())">
                        @TranslateMovement(context.MovementType.ToString())
                    </MudChip>
                </MudTd>
                <MudTd>
                    <span style="color: @(context.Quantity >= 0 ? "green" : "red");">
                        @(context.Quantity >= 0 ? "+" : "")@context.Quantity
                    </span>
                </MudTd>
                <MudTd>@context.BalanceAfter</MudTd>
                <MudTd>@(context.UnitCost?.ToString("N2") ?? "-")</MudTd>
                <MudTd>@context.ReferenceType</MudTd>
                <MudTd>@context.Notes</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<ProductDto>? products;
    private int? selectedVariantId;
    private List<MAS.Domain.Entities.StockMovement>? movements;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
            products = await ProductService.GetProductsAsync(Session.BrandId);
    }

    private async Task LoadMovements()
    {
        if (!selectedVariantId.HasValue) return;
        movements = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(
            Context.StockMovements
                .Where(m => m.VariantId == selectedVariantId.Value)
                .OrderByDescending(m => m.CreatedAt)
                .Take(100)
        );
    }

    private string TranslateMovement(string type) => type switch
    {
        "Purchase" => "شراء",
        "Sale" => "بيع",
        "Return" => "مرتجع",
        "TransferIn" => "تحويل وارد",
        "TransferOut" => "تحويل صادر",
        "Adjustment" => "تسوية",
        "ProductionIn" => "إنتاج وارد",
        "ProductionOut" => "إنتاج صادر",
        "Waste" => "هالك",
        _ => type
    };

    private Color GetMovementColor(string type) => type switch
    {
        "Purchase" or "Return" or "TransferIn" or "ProductionIn" or "Adjustment" => Color.Success,
        "Sale" or "TransferOut" or "ProductionOut" or "Waste" => Color.Error,
        _ => Color.Default
    };
}
