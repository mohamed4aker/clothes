@page "/returns"
@inject ISalesReturnService ReturnService
@inject ISalesService SalesService
@inject UserSession Session
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>المرتجعات - MAS</PageTitle>

<MudGrid>
    <MudItem xs="12" Class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.h4">↩️ مرتجعات المبيعات</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenReturnDialog">
            مرتجع جديد
        </MudButton>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mt-3">
    @if (returns == null) { <MudProgressLinear Indeterminate="true" /> }
    else if (!returns.Any()) { <MudAlert Severity="Severity.Info">لا يوجد مرتجعات مسجلة.</MudAlert> }
    else
    {
        <MudTable Items="@returns" Hover="true" Bordered="true">
            <HeaderContent>
                <MudTh>رقم المرتجع</MudTh>
                <MudTh>الفاتورة الأصلية</MudTh>
                <MudTh>التاريخ</MudTh>
                <MudTh>العميل</MudTh>
                <MudTh>المبلغ المردود</MudTh>
                <MudTh>طريقة الإرجاع</MudTh>
                <MudTh>السبب</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ReturnNumber</MudTd>
                <MudTd>@context.OriginalInvoiceNumber</MudTd>
                <MudTd>@context.ReturnDate.ToString("yyyy/MM/dd HH:mm")</MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd><strong>@context.RefundAmount.ToString("N2")</strong></MudTd>
                <MudTd>@(context.RefundMethod == "Cash" ? "كاش" : "رصيد للعميل")</MudTd>
                <MudTd>@context.Reason</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<SalesReturnDto>? returns;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        if (Session.IsAuthenticated)
            returns = await ReturnService.GetReturnsAsync(Session.BrandId);
    }

    private async Task OpenReturnDialog()
    {
        var dialog = DialogService.Show<ReturnDialog>("مرتجع جديد", new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (!result.Canceled) { Snackbar.Add("تم تسجيل المرتجع", Severity.Success); await LoadData(); }
    }
}
