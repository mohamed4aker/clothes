@page "/accounting-reports"
@inject ISalesService SalesService
@inject IPurchaseService PurchaseService
@inject IExpenseService ExpenseService
@inject IReportsService ReportsService
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>التقارير المحاسبية - MAS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">📊 التقارير المحاسبية</MudText>

<!-- اختيار الفترة -->
<MudPaper Class="pa-3 mb-3">
    <MudGrid AlignItems="AlignItems.Center">
        <MudItem xs="12" md="3">
            <MudDatePicker @bind-Date="fromDate" Label="من" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker @bind-Date="toDate" Label="إلى" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAll" 
                       FullWidth="true" StartIcon="@Icons.Material.Filled.Refresh" Style="height:56px;">
                عرض التقرير
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (loading) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <!-- قائمة الدخل -->
    <MudPaper Class="pa-4 mb-3">
        <MudText Typo="Typo.h5" Class="mb-3">📈 قائمة الدخل</MudText>
        
        <MudTable Items="@incomeStatementItems" Dense="true" Bordered="true">
            <HeaderContent>
                <MudTh>البند</MudTh>
                <MudTh>القيمة</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Item1</MudTd>
                <MudTd Style="@(context.Item3 ? "font-weight: bold;" : "")">
                    <span style="color: @(context.Item2 >= 0 ? "green" : "red");">
                        @context.Item2.ToString("N2") ج
                    </span>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <!-- ميزان المراجعة المبسط -->
    <MudPaper Class="pa-4 mb-3">
        <MudText Typo="Typo.h5" Class="mb-3">⚖️ ميزان المراجعة المبسط</MudText>
        
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-3" Style="background: #f0fdf4;">
                    <MudText Typo="Typo.h6" Color="Color.Success">المدين (Debit)</MudText>
                    <MudDivider Class="my-2" />
                    <div class="d-flex justify-space-between">
                        <span>المشتريات:</span>
                        <strong>@totalPurchases.ToString("N2") ج</strong>
                    </div>
                    <div class="d-flex justify-space-between">
                        <span>المصاريف:</span>
                        <strong>@totalExpenses.ToString("N2") ج</strong>
                    </div>
                    <MudDivider Class="my-2" />
                    <div class="d-flex justify-space-between">
                        <strong>الإجمالي:</strong>
                        <strong style="color: green;">@((totalPurchases + totalExpenses).ToString("N2")) ج</strong>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-3" Style="background: #fef2f2;">
                    <MudText Typo="Typo.h6" Color="Color.Error">الدائن (Credit)</MudText>
                    <MudDivider Class="my-2" />
                    <div class="d-flex justify-space-between">
                        <span>المبيعات:</span>
                        <strong>@totalSales.ToString("N2") ج</strong>
                    </div>
                    <MudDivider Class="my-2" />
                    <div class="d-flex justify-space-between">
                        <strong>الإجمالي:</strong>
                        <strong style="color: red;">@totalSales.ToString("N2") ج</strong>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- المؤشرات الرئيسية -->
    <MudPaper Class="pa-4 mb-3">
        <MudText Typo="Typo.h5" Class="mb-3">📊 المؤشرات الرئيسية</MudText>
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3 text-center" Style="background: #ecfdf5;">
                    <MudText Typo="Typo.subtitle2">إجمالي الإيرادات</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success">@totalSales.ToString("N2") ج</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3 text-center" Style="background: #fef3c7;">
                    <MudText Typo="Typo.subtitle2">إجمالي التكاليف</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Warning">@cogs.ToString("N2") ج</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3 text-center" Style="background: #fee2e2;">
                    <MudText Typo="Typo.subtitle2">إجمالي المصروفات</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Error">@((totalPurchases + totalExpenses).ToString("N2")) ج</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3 text-center" Style="@NetProfitStyle">
                    <MudText Typo="Typo.subtitle2">صافي الربح</MudText>
                    <MudText Typo="Typo.h5" Color="@(netProfit >= 0 ? Color.Success : Color.Error)">
                        @netProfit.ToString("N2") ج
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- روابط لتقارير تانية -->
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">🔗 تقارير أخرى</MudText>
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Outlined" FullWidth="true" 
                           StartIcon="@Icons.Material.Filled.Storage"
                           OnClick="@(() => Nav.NavigateTo("/stock-report"))">
                    مخزون الأصناف
                </MudButton>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Outlined" FullWidth="true" 
                           StartIcon="@Icons.Material.Filled.Star"
                           OnClick="@(() => Nav.NavigateTo("/top-products"))">
                    الأكثر مبيعاً
                </MudButton>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Outlined" FullWidth="true" 
                           StartIcon="@Icons.Material.Filled.Analytics"
                           OnClick="@(() => Nav.NavigateTo("/reports"))">
                    التقارير الكاملة
                </MudButton>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Outlined" FullWidth="true" 
                           StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
                           OnClick="@(() => Nav.NavigateTo("/treasury"))">
                    الخزنة
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private DateTime? fromDate = DateTime.Now.AddMonths(-1);
    private DateTime? toDate = DateTime.Now;
    private decimal totalSales = 0;
    private decimal totalPurchases = 0;
    private decimal totalExpenses = 0;
    private decimal cogs = 0;
    private bool loading = true;

    private decimal netProfit => totalSales - cogs - totalExpenses;
    private string NetProfitStyle => netProfit >= 0 
        ? "background: #dbeafe;" 
        : "background: #fecaca;";

    private List<(string, decimal, bool)> incomeStatementItems = new();

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        if (!Session.IsAuthenticated || !fromDate.HasValue || !toDate.HasValue) return;
        loading = true;
        try
        {
            totalSales = await SalesService.GetTotalSalesAsync(Session.BrandId, fromDate.Value, toDate.Value.AddDays(1));
            totalPurchases = await PurchaseService.GetTotalPurchasesAsync(Session.BrandId, fromDate.Value, toDate.Value.AddDays(1));
            totalExpenses = await ExpenseService.GetTotalExpensesAsync(Session.BrandId, fromDate.Value, toDate.Value.AddDays(1));

            var report = await ReportsService.GetSalesReportAsync(Session.BrandId, fromDate.Value, toDate.Value.AddDays(1));
            cogs = report.TotalCOGS;

            // قائمة الدخل
            incomeStatementItems = new()
            {
                ("الإيرادات (المبيعات)", totalSales, false),
                ("(-) تكلفة البضاعة المباعة (COGS)", -cogs, false),
                ("= إجمالي الربح (Gross Profit)", totalSales - cogs, true),
                ("(-) المصاريف التشغيلية", -totalExpenses, false),
                ("= صافي الربح قبل الضرائب", netProfit, true),
            };
        }
        catch { }
        finally { loading = false; }
    }
}
